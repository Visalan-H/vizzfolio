---
import BaseLayout from "../layouts/BaseLayout.astro";
import Intro from "../components/Intro.astro";
import Nav from "../components/Nav.astro";
import Socials from "../components/Socials.astro";
import SectionDescription from "../components/SectionDescription.astro";
import Experience from "../components/Experience.astro";
import Projects from "../components/Projects.astro";
import College from "../components/College.astro";
import Extensions from "../components/Extensions.astro";
import NPMPackages from "../components/NPMPackages.astro";
import Education from "../components/Education.astro";
import LinkedInCTA from "../components/LinkedInCTA.astro";
import ResumeCTA from "../components/ResumeCTA.astro";
---

<BaseLayout showPreloader={true}>
  <div slot="sidebar" class="flex flex-col justify-between h-full">
    <div>
      <Intro />
      <Nav />
      <SectionDescription />
      <LinkedInCTA variant="desktop" />
      <ResumeCTA />
    </div>
    <Socials />
  </div>

  <!-- Mobile floating CTA -->
  <LinkedInCTA variant="mobile" />

  <College />
  <Projects />
  <Extensions />
  <NPMPackages />
  <Experience />
  <Education />
</BaseLayout>
