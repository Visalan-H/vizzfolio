---
import "../styles/global.css";
import { meta } from "../data/portfolio.json";
import ThemeToggle from "../components/ThemeToggle.astro";

interface Props {
  title?: string;
  showPreloader?: boolean;
  wide?: boolean;
}

const { title = meta.title, showPreloader = false, wide = false } = Astro.props;
const description = meta.description;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="https://fav.farm/🤓" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Prevent flash of wrong theme -->
    <script is:inline>
      (function() {
        var t = localStorage.getItem('theme') || 'dark';
        document.documentElement.setAttribute('data-theme', t);
      })();
    </script>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://visalan.me" />
    <meta property="og:image" content="https://visalan.me/preview.png" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://visalan.me/preview.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300..700&display=swap"
      rel="stylesheet"
    />
    <style>
      /* Preloader styles */
      #preloader {
        position: fixed;
        inset: 0;
        z-index: 9999;
        background: var(--color-background);
        pointer-events: none;
      }

      #preloader-name {
        position: fixed;
        font-family: "Quicksand", sans-serif;
        font-size: clamp(2.5rem, 10vw, 4rem);
        font-weight: 700;
        color: var(--color-primary);
        letter-spacing: 0;
        white-space: nowrap;
        will-change: transform;
        transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
      }

      #preloader-name.centered {
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
      }

      /* Background fade */
      #preloader.fade-bg {
        animation: bgFade 0.3s cubic-bezier(0.23, 1, 0.32, 1) 0.3s forwards;
      }

      @keyframes bgFade {
        to {
          background: transparent;
        }
      }

      #preloader.done {
        opacity: 0;
        transition: opacity 0.2s cubic-bezier(0.23, 1, 0.32, 1);
      }

      /* Content transitions */
      .content-hidden {
        opacity: 0;
      }

      .content-visible {
        animation: fadeIn 0.3s cubic-bezier(0.23, 1, 0.32, 1) 0.3s forwards;
      }

      @keyframes fadeIn {
        to {
          opacity: 1;
        }
      }

      /* Hide the actual intro name initially */
      #intro-name {
        opacity: 0;
      }

      #intro-name.visible {
        opacity: 1;
        transition: opacity 0.2s cubic-bezier(0.23, 1, 0.32, 1);
      }
    </style>
  </head>
  <body
    class="bg-background text-primary antialiased selection:bg-slate-700 selection:text-white leading-relaxed"
  >
    <ThemeToggle />
    <!-- Preloader -->
    {
      showPreloader && (
        <div id="preloader">
          <div id="preloader-name" class="centered" />
        </div>
      )
    }

    <div
      id="main-content"
      class:list={[
        "mx-auto min-h-screen px-6 font-sans md:px-12 md:py-20 lg:py-0",
        wide ? "max-w-none py-8" : "max-w-7xl lg:px-24 py-12",
        { "content-hidden": showPreloader },
      ]}
    >
      <div
        class:list={[
          "lg:flex lg:justify-between lg:gap-4",
          { "lg:block": wide },
        ]}
      >
        <!-- Left Column: Fixed/Sticky (hidden when wide) -->
        {
          !wide && (
            <header class="lg:sticky lg:top-0 lg:flex lg:h-screen lg:w-1/2 lg:flex-col lg:justify-between lg:pt-24 lg:pb-4">
              <slot name="sidebar" />
            </header>
          )
        }

        <!-- Right Column: Scrollable (Full width when wide) -->
        <main
          class:list={[
            "lg:pt-24 lg:pb-24",
            wide ? "lg:w-full pt-0" : "lg:w-1/2 lg:pb-96 pt-8",
          ]}
        >
          <slot />
        </main>
      </div>
    </div>

    {
      showPreloader && (
        <script>
          import {initPreloader} from "../scripts/preloader.js";
          initPreloader();
        </script>
      )
    }
  </body>
</html>
