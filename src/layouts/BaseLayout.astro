---
import "../styles/global.css";
import {meta} from "../data/portfolio.json";

interface Props {
  title?: string;
}

const { title = meta.title } = Astro.props;
const description = meta.description;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="https://fav.farm/🤓" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300..700&display=swap"
      rel="stylesheet"
    />
    <style>
      /* Preloader styles */
      #preloader {
        position: fixed;
        inset: 0;
        z-index: 9999;
        background: #111111;
        pointer-events: none;
      }

      #preloader-name {
        position: fixed;
        font-family: "Quicksand", sans-serif;
        font-size: clamp(2.5rem, 10vw, 4rem);
        font-weight: 700;
        color: #e2e8f0;
        letter-spacing: 0;
        white-space: nowrap;
        will-change: transform;
        transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
      }

      #preloader-name.centered {
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
      }

      /* Background fade */
      #preloader.fade-bg {
        animation: bgFade 0.4s ease-out 0.4s forwards;
      }

      @keyframes bgFade {
        to {
          background: transparent;
        }
      }

      #preloader.done {
        opacity: 0;
        transition: opacity 0.3s ease-out;
      }

      /* Content transitions */
      .content-hidden {
        opacity: 0;
      }

      .content-visible {
        animation: fadeIn 0.4s ease-out 0.5s forwards;
      }

      @keyframes fadeIn {
        to {
          opacity: 1;
        }
      }

      /* Hide the actual intro name initially */
      #intro-name {
        opacity: 0;
      }

      #intro-name.visible {
        opacity: 1;
        transition: opacity 0.2s ease-out;
      }
    </style>
  </head>
  <body
    class="bg-background text-primary antialiased selection:bg-slate-700 selection:text-white leading-relaxed"
  >
    <!-- Preloader -->
    <div id="preloader">
      <div id="preloader-name" class="centered"></div>
    </div>
    <div
      id="main-content"
      class="content-hidden mx-auto min-h-screen max-w-7xl px-6 py-12 font-sans md:px-12 md:py-20 lg:px-24 lg:py-0"
    >
      <div class="lg:flex lg:justify-between lg:gap-4">
        <!-- Left Column: Fixed/Sticky -->
        <header
          class="lg:sticky lg:top-0 lg:flex lg:h-screen lg:w-1/2 lg:flex-col lg:justify-between lg:pt-24 lg:pb-4"
        >
          <slot name="sidebar" />
        </header>

        <!-- Right Column: Scrollable -->
        <main class="lg:pt-24 pt-8  lg:w-1/2 lg:pt-24 lg:pb-96">
          <slot />
        </main>
      </div>
    </div>

    <script>
      import "../scripts/preloader.js";
    </script>
  </body>
</html>
