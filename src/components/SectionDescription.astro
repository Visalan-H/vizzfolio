---
import { sectionDescriptions } from "../data/portfolio.json";

const sections = [
  "projects",
  "extensions",
  "npm-packages",
  "experience",
  "education",
] as const;
---

<div
  id="section-description"
  class="hidden lg:block mt-8 text-slate-400 max-w-xs"
>
  {
    sections.map((id, i) => (
      <p data-section={id} class:list={["desc-text", { hidden: i !== 0 }]}>
        {sectionDescriptions[id]}
      </p>
    ))
  }
</div>

<script>
  const descs = document.querySelectorAll<HTMLElement>(".desc-text");

  addEventListener("section-change", (e: Event) => {
    const id = (e as CustomEvent).detail;
    descs.forEach((d) =>
      d.classList.toggle("hidden", d.dataset.section !== id),
    );
  });
</script>
