---
import { Icon } from "astro-icon/components";
import { socials } from "../data/portfolio.json";

// Minimal mapping or direct usage if names match
const iconMap: Record<string, string> = {
  github: "simple-icons:github",
  linkedin: "simple-icons:linkedin",
  leetcode: "simple-icons:leetcode",
  codepen: "simple-icons:codepen",
  medium: "simple-icons:medium",
  email: "simple-icons:gmail",
};
---

<ul class="flex items-center gap-4 mt-8 lg:mt-0" aria-label="Social media">
  {
    socials.map((social) => {
      const isEmail = social.icon === "email";
      if (isEmail) {
        return (
          <li>
            <button
              class="text-slate-400 hover:text-slate-100 transition-all duration-300 hover:-translate-y-1 inline-block cursor-pointer email-copy-link relative"
              data-copy-value={social.href.replace("mailto:", "")}
              aria-label="Copy email to clipboard"
            >
              <span class="sr-only">{social.name}</span>
              <span class="absolute -top-8 left-1/2 -translate-x-1/2 bg-slate-800 text-slate-100 text-xs px-2 py-1 rounded opacity-0 transition-opacity duration-300 pointer-events-none copy-feedback whitespace-nowrap">
                Copied!
              </span>
              <div class="relative grid place-items-center">
                <Icon
                  name={iconMap[social.icon]}
                  size={24}
                  class="transition-all duration-300 scale-100 opacity-100 icon-original"
                />
                <Icon
                  name="lucide:check"
                  size={24}
                  class="transition-all duration-300 scale-0 opacity-0 absolute inset-0 icon-success text-green-500"
                />
              </div>
            </button>
          </li>
        );
      }

      return (
        <li>
          <a
            href={social.href}
            target="_blank"
            rel="noreferrer"
            class="text-slate-400 hover:text-slate-100 transition-all duration-300 hover:-translate-y-1 inline-block"
          >
            <span class="sr-only">{social.name}</span>
            <Icon
              name={iconMap[social.icon] || social.icon}
              size={24}
              class="transition-colors"
            />
          </a>
        </li>
      );
    })
  }
</ul>

<script>
  document.querySelectorAll(".email-copy-link").forEach((link) => {
    link.addEventListener("click", () => {
      const text = link.getAttribute("data-copy-value");
      if (text) {
        navigator.clipboard.writeText(text);

        const original = link.querySelector(".icon-original");
        const success = link.querySelector(".icon-success");
        const feedback = link.querySelector(".copy-feedback");

        if (original && success && feedback) {
          original.classList.add("scale-0", "opacity-0");
          original.classList.remove("scale-100", "opacity-100");

          success.classList.remove("scale-0", "opacity-0");
          success.classList.add("scale-100", "opacity-100");

          feedback.classList.remove("opacity-0");
          feedback.classList.add("opacity-100");

          setTimeout(() => {
            original.classList.remove("scale-0", "opacity-0");
            original.classList.add("scale-100", "opacity-100");

            success.classList.add("scale-0", "opacity-0");
            success.classList.remove("scale-100", "opacity-100");

            feedback.classList.add("opacity-0");
            feedback.classList.remove("opacity-100");
          }, 2000);
        }
      }
    });
  });
</script>
