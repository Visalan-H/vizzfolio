---
import { Icon } from "astro-icon/components";
import { experience, sectionDescriptions } from "../data/portfolio.json";
const experiences = experience;
---

<section
  id="experience"
  class="mb-16 scroll-mt-16 md:mb-24 lg:mb-16 lg:scroll-mt-24"
  aria-label="Work experience"
>
  <div
    class="sticky top-0 z-20 -mx-6 mb-6 w-screen bg-background/90 px-6 py-5 pb-4 backdrop-blur md:-mx-12 md:px-12 lg:sr-only lg:relative lg:top-auto lg:mx-auto lg:w-full lg:px-0 lg:py-0 lg:opacity-0 lg:mb-4"
  >
    <h2
      class="text-sm font-bold uppercase tracking-widest text-slate-200 lg:sr-only"
    >
      Experience
    </h2>
    <p class="mt-2 text-sm text-slate-400 lg:hidden">
      {sectionDescriptions.experience}
    </p>
  </div>
  <div>
    <ol class="group/list">
      {
        experiences.map((experience) => (
          <li class="mb-12">
            <div class="group relative grid pb-1 transition-all sm:grid-cols-8 sm:gap-8 md:gap-4 lg:hover:opacity-100! lg:group-hover/list:opacity-50">
              <div class="absolute -inset-x-4 -inset-y-4 z-0 hidden rounded-md transition motion-reduce:transition-none lg:-inset-x-6 lg:block lg:group-hover:bg-slate-800/50 lg:group-hover:shadow-[inset_0_1px_0_0_rgba(148,163,184,0.1)] lg:group-hover:drop-shadow-lg" />
              <header
                class="z-10 mb-2 mt-1 text-xs font-semibold uppercase tracking-wide text-slate-400 sm:col-span-2"
                aria-label={experience.date}
              >
                {experience.date}
              </header>
              <div class="z-10 sm:col-span-6">
                <h3 class="font-medium leading-snug text-slate-200">
                  <div>
                    <a
                      class="inline-flex items-baseline font-medium leading-tight text-slate-200 hover:text-slate-100 focus-visible:text-slate-100 group/link"
                      href={experience.url}
                      target="_blank"
                      rel="noreferrer"
                      aria-label={experience.title}
                    >
                      <span class="absolute -inset-x-4 -inset-y-2.5 hidden rounded md:-inset-x-6 md:-inset-y-4 lg:block" />
                      <span>
                        {experience.title} @{" "}
                        <span class="inline-block">
                          {experience.company}{" "}
                          <Icon
                            name="lucide:arrow-up-right"
                            class="inline-block h-4 w-4 shrink-0 transition-transform duration-300 group-hover/link:-translate-y-1 group-hover/link:translate-x-1 group-focus-visible/link:-translate-y-1 group-focus-visible/link:translate-x-1 motion-reduce:transition-none"
                            aria-hidden="true"
                          />
                        </span>
                      </span>
                    </a>
                  </div>
                </h3>
                <p class="mt-2 text-sm leading-normal text-slate-400">
                  {experience.seniorLink ? (
                    <Fragment>
                      Collaborated with a{" "}
                      <a
                        href={experience.seniorLink}
                        target="_blank"
                        rel="noreferrer"
                        class="relative z-20 text-slate-200 hover:text-teal-400 transition-colors"
                      >
                        senior
                      </a>{" "}
                      to deliver a smooth, animated website that the US client
                      loved.
                    </Fragment>
                  ) : (
                    experience.description
                  )}
                </p>
                <ul class="mt-2 flex flex-wrap" aria-label="Technologies used">
                  {experience.tags.map((tag) => (
                    <li class="mr-1.5 mt-2">
                      <div class="flex items-center rounded-full bg-slate-800/50 px-3 py-1 text-xs font-medium leading-5 text-slate-300">
                        {tag}
                      </div>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
