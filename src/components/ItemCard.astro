---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  description: string;
  link: string;
  tags: string[];
  image?: ImageMetadata | null;
  year?: string;
  index: number;
}

const { title, description, link, tags, image, year, index } = Astro.props;
---

<article
  class="group relative flex flex-col items-start rounded-xl border border-slate-800/50 bg-slate-800/20 transition-all duration-200 ease-out-strong hover:bg-slate-800/30 hover:shadow-lg active:scale-[0.98] overflow-hidden"
>
  <div class="relative w-full aspect-video overflow-hidden border-b border-transparent transition-colors duration-200 ease-out-strong group-hover:border-slate-800/50">
    {
      image && (
        <Image
          src={image}
          alt={title}
          class="h-full w-full object-cover transition-transform duration-300 ease-out-strong group-hover:scale-[1.03]"
          loading={index < 6 ? "eager" : "lazy"}
          fetchpriority={index < 6 ? "high" : "auto"}
          width={600}
          height={400}
          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
        />
      )
    }
    <div
      class="absolute inset-0 bg-slate-900/0 transition-colors duration-200 ease-out-strong group-hover:bg-slate-900/10"
    >
    </div>
  </div>

  <div class="p-5 space-y-2 w-full flex flex-col flex-1">
    {
      year && (
        <div class="text-xs font-semibold uppercase tracking-wider text-slate-500">
          {year}
        </div>
      )
    }

    <h3 class="text-xl font-bold text-slate-200">
      <a
        href={link}
        target="_blank"
        rel="noopener noreferrer"
        class="focus-visible:text-teal-300"
      >
        <span class="absolute inset-0"></span>
        {title}
        <Icon
          name="lucide:arrow-up-right"
          class="inline-block ml-1 h-4 w-4 mb-1 transition-transform duration-200 ease-out-strong group-hover:-translate-y-1 group-hover:translate-x-1 motion-reduce:transition-none"
        />
      </a>
    </h3>

    <p class="text-sm leading-normal text-slate-400 line-clamp-2">
      {description}
    </p>

    <ul
      class="flex flex-wrap gap-2 mt-auto pt-3"
      aria-label="Technologies used"
    >
      {
        tags.map((tag) => (
          <li class="rounded-full bg-teal-400/10 px-3 py-1 text-xs font-medium leading-5 text-teal-300">
            {tag}
          </li>
        ))
      }
    </ul>
  </div>
</article>
