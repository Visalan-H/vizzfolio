---
import data from "../data/portfolio.json";
---

<div class="space-y-4">
  <h1 class="text-4xl font-bold tracking-tight text-slate-200 sm:text-5xl">
    <a id="intro-name" href="/">{data.intro.name}</a>
  </h1>
  <p class="max-w-xs leading-normal text-slate-400">
    <span class="text-slate-200 font-medium">{data.intro.title}</span> building
    {data.intro.bio}
  </p>
</div>
