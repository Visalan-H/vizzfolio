---
---

<button
  id="theme-toggle"
  aria-label="Toggle dark/light mode"
  aria-pressed="false"
  class="group fixed top-5 right-5 z-50 h-10 w-10 rounded-[10px] border border-slate-800/80 bg-background/35 flex items-center justify-center cursor-pointer text-slate-500 backdrop-blur-md"
>
  <svg
    class="theme-toggle-svg"
    width="16"
    height="16"
    viewBox="-2 -2 28 28"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    overflow="visible"
  >
    <mask id="moon-mask">
      <rect x="-2" y="-2" width="28" height="28" fill="white" />
      <circle cx="28" cy="6" r="8" fill="black" class="moon-mask-circle" />
    </mask>
    <circle
      class="sun-core"
      cx="12"
      cy="12"
      r="5"
      mask="url(#moon-mask)"
      fill="currentColor"
      stroke="none"
    />
    <g class="sun-rays" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <line x1="12" y1="1" x2="12" y2="3" />
      <line x1="12" y1="21" x2="12" y2="23" />
      <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
      <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
      <line x1="1" y1="12" x2="3" y2="12" />
      <line x1="21" y1="12" x2="23" y2="12" />
      <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
      <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
    </g>
  </svg>
</button>

<style>
  #theme-toggle {
    transition:
      transform 160ms cubic-bezier(0.23, 1, 0.32, 1),
      color 180ms cubic-bezier(0.23, 1, 0.32, 1),
      border-color 180ms cubic-bezier(0.23, 1, 0.32, 1),
      background-color 180ms cubic-bezier(0.23, 1, 0.32, 1);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.18);
  }

  #theme-toggle:hover {
    color: var(--color-primary);
    border-color: color-mix(in srgb, var(--color-primary) 26%, transparent);
    background: color-mix(in srgb, var(--color-background) 74%, transparent);
    transform: translateY(-1px);
  }

  #theme-toggle:active {
    transform: scale(0.96);
  }

  .theme-toggle-svg {
    transition: transform 0.56s cubic-bezier(0.23, 1, 0.32, 1);
    will-change: transform;
  }

  .sun-core {
    transition: r 0.56s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .moon-mask-circle {
    transition:
          cx 0.56s cubic-bezier(0.23, 1, 0.32, 1),
          cy 0.56s cubic-bezier(0.23, 1, 0.32, 1),
          r 0.56s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .sun-rays {
    transition:
      opacity 0.2s cubic-bezier(0.23, 1, 0.32, 1),
      transform 0.56s cubic-bezier(0.23, 1, 0.32, 1);
    transform-origin: center;
  }

  #theme-toggle[data-busy="true"] {
    pointer-events: none;
  }

  /* Light mode → morphs into crescent moon */
  :global([data-theme="light"]) .theme-toggle-svg {
    transform: rotate(-42deg) scale(1.04);
  }

  :global([data-theme="light"]) .sun-core {
    r: 9;
  }

  :global([data-theme="light"]) .moon-mask-circle {
    cx: 18;
    cy: 6;
    r: 8;
  }

  :global([data-theme="light"]) .sun-rays {
    opacity: 0;
    transform: rotate(-100deg) scale(0.84);
  }

  :global(::view-transition-group(root)) {
    animation: none;
  }

  :global(::view-transition-old(root)),
  :global(::view-transition-new(root)) {
    animation: none;
    mix-blend-mode: normal;
    display: block;
  }

  :global(::view-transition-old(root)) {
    z-index: 1;
  }

  :global(::view-transition-new(root)) {
    z-index: 2;
  }

  @media (prefers-reduced-motion: reduce) {
    #theme-toggle,
    .theme-toggle-svg,
    .sun-core,
    .moon-mask-circle,
    .sun-rays {
      transition: none !important;
    }
  }
</style>

<script>
  const toggle = document.getElementById("theme-toggle") as HTMLButtonElement | null;

  if (toggle) {
    const root = document.documentElement;
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    const setTheme = (theme: string) => {
      root.setAttribute("data-theme", theme);
      localStorage.setItem("theme", theme);
      toggle.setAttribute("aria-pressed", String(theme === "light"));
    };

    const stored = localStorage.getItem("theme") || "dark";
    setTheme(stored);

    let isSwitching = false;

    const runWaveTransition = (nextTheme: string, x: number, y: number) => {
      if (isSwitching) {
        return;
      }

      isSwitching = true;
      toggle.dataset.busy = "true";

      const documentWithTransition = document as Document & {
        startViewTransition?: (updateCallback: () => void) => {
          ready: Promise<void>;
          finished: Promise<void>;
        };
      };

      const canUseViewTransition = Boolean(documentWithTransition.startViewTransition);

      if (!canUseViewTransition) {
        setTheme(nextTheme);
        delete toggle.dataset.busy;
        isSwitching = false;
        return;
      }

      const maxHorizontal = Math.max(x, window.innerWidth - x);
      const maxVertical = Math.max(y, window.innerHeight - y);
      const endRadius = Math.hypot(maxHorizontal, maxVertical);

      const transition = documentWithTransition.startViewTransition!(() => {
        setTheme(nextTheme);
      });

      transition.ready
        .then(() => {
          document.documentElement.animate(
            {
              clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${endRadius}px at ${x}px ${y}px)`],
            },
            {
              duration: 500,
              easing: "ease-in-out",
              pseudoElement: "::view-transition-new(root)",
            }
          );
        })
        .catch(() => {
          setTheme(nextTheme);
        });

      transition.finished.finally(() => {
        delete toggle.dataset.busy;
        isSwitching = false;
      });
    };

    toggle.addEventListener("click", () => {
      if (isSwitching) {
        return;
      }

      const current = root.getAttribute("data-theme") || "dark";
      const nextTheme = current === "dark" ? "light" : "dark";

      if (prefersReducedMotion.matches) {
        setTheme(nextTheme);
        return;
      }

      const rect = toggle.getBoundingClientRect();
      const x = rect.left + rect.width / 2;
      const y = rect.top + rect.height / 2;

      runWaveTransition(nextTheme, x, y);
    });
  }
</script>
