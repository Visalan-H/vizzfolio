---
---

<button
  id="theme-toggle"
  aria-label="Toggle dark/light mode"
  aria-pressed="false"
  class="group fixed top-5 right-5 z-50 h-10 w-10 rounded-[10px] border border-slate-800/80 bg-background/35 flex items-center justify-center cursor-pointer text-slate-300 backdrop-blur-md"
>
  <svg class="theme-icon theme-icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
  </svg>
  <svg class="theme-icon theme-icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
  </svg>
</button>

<style>
  #theme-toggle {
    transition:
      transform 160ms cubic-bezier(0.23, 1, 0.32, 1),
      color 180ms cubic-bezier(0.23, 1, 0.32, 1),
      border-color 180ms cubic-bezier(0.23, 1, 0.32, 1),
      background-color 180ms cubic-bezier(0.23, 1, 0.32, 1);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.18);
  }

  #theme-toggle:hover {
    color: var(--color-primary);
    border-color: color-mix(in srgb, var(--color-primary) 26%, transparent);
    background: color-mix(in srgb, var(--color-background) 74%, transparent);
    transform: translateY(-1px);
  }

  #theme-toggle:active {
    transform: scale(0.96);
  }

  .theme-icon {
    position: absolute;
    transition:
      opacity 0.3s cubic-bezier(0.23, 1, 0.32, 1),
      transform 0.5s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .theme-icon-moon {
    opacity: 0;
    transform: rotate(-70deg) scale(0.6);
  }

  #theme-toggle[data-busy="true"] {
    pointer-events: none;
  }

  /* The sun shows in dark mode and the moon in light mode */
  :global([data-theme="light"]) .theme-icon-sun {
    opacity: 0;
    transform: rotate(70deg) scale(0.6);
  }

  :global([data-theme="light"]) .theme-icon-moon {
    opacity: 1;
    transform: none;
  }

  :global(::view-transition-group(root)) {
    animation: none;
  }

  :global(::view-transition-old(root)),
  :global(::view-transition-new(root)) {
    animation: none;
    mix-blend-mode: normal;
    display: block;
  }

  :global(::view-transition-old(root)) {
    z-index: 1;
  }

  :global(::view-transition-new(root)) {
    z-index: 2;
  }

  @media (prefers-reduced-motion: reduce) {
    #theme-toggle,
    .theme-icon {
      transition: none !important;
    }
  }
</style>

<script>
  const toggle = document.getElementById("theme-toggle") as HTMLButtonElement | null;

  if (toggle) {
    const root = document.documentElement;
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    const setTheme = (theme: string) => {
      root.setAttribute("data-theme", theme);
      localStorage.setItem("theme", theme);
      toggle.setAttribute("aria-pressed", String(theme === "light"));
    };

    const stored = localStorage.getItem("theme") || "dark";
    setTheme(stored);

    let isSwitching = false;

    const runWaveTransition = (nextTheme: string, x: number, y: number) => {
      if (isSwitching) {
        return;
      }

      isSwitching = true;
      toggle.dataset.busy = "true";

      const documentWithTransition = document as Document & {
        startViewTransition?: (updateCallback: () => void) => {
          ready: Promise<void>;
          finished: Promise<void>;
        };
      };

      const canUseViewTransition = Boolean(documentWithTransition.startViewTransition);

      if (!canUseViewTransition) {
        setTheme(nextTheme);
        delete toggle.dataset.busy;
        isSwitching = false;
        return;
      }

      const maxHorizontal = Math.max(x, window.innerWidth - x);
      const maxVertical = Math.max(y, window.innerHeight - y);
      const endRadius = Math.hypot(maxHorizontal, maxVertical);

      const transition = documentWithTransition.startViewTransition!(() => {
        setTheme(nextTheme);
      });

      transition.ready
        .then(() => {
          document.documentElement.animate(
            {
              clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${endRadius}px at ${x}px ${y}px)`],
            },
            {
              duration: 500,
              easing: "ease-in-out",
              pseudoElement: "::view-transition-new(root)",
            }
          );
        })
        .catch(() => {
          setTheme(nextTheme);
        });

      transition.finished.finally(() => {
        delete toggle.dataset.busy;
        isSwitching = false;
      });
    };

    toggle.addEventListener("click", () => {
      if (isSwitching) {
        return;
      }

      const current = root.getAttribute("data-theme") || "dark";
      const nextTheme = current === "dark" ? "light" : "dark";

      if (prefersReducedMotion.matches) {
        setTheme(nextTheme);
        return;
      }

      const rect = toggle.getBoundingClientRect();
      const x = rect.left + rect.width / 2;
      const y = rect.top + rect.height / 2;

      runWaveTransition(nextTheme, x, y);
    });
  }
</script>
