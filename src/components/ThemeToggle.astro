---
---

<button
  id="theme-toggle"
  aria-label="Toggle dark/light mode"
  class="fixed top-5 right-5 z-50 h-8 w-8 rounded-[4px] border border-slate-800 bg-transparent flex items-center justify-center cursor-pointer transition-all duration-300 hover:border-slate-400 text-slate-500 hover:text-slate-200"
>
  <svg
    class="theme-toggle-svg"
    width="16"
    height="16"
    viewBox="-2 -2 28 28"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    overflow="visible"
  >
    <mask id="moon-mask">
      <rect x="-2" y="-2" width="28" height="28" fill="white" />
      <circle cx="28" cy="6" r="8" fill="black" class="moon-mask-circle" />
    </mask>
    <circle
      class="sun-core"
      cx="12"
      cy="12"
      r="5"
      mask="url(#moon-mask)"
      fill="currentColor"
      stroke="none"
    />
    <g class="sun-rays" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <line x1="12" y1="1" x2="12" y2="3" />
      <line x1="12" y1="21" x2="12" y2="23" />
      <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
      <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
      <line x1="1" y1="12" x2="3" y2="12" />
      <line x1="21" y1="12" x2="23" y2="12" />
      <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
      <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
    </g>
  </svg>
</button>

<style>
  .theme-toggle-svg {
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .sun-core {
    transition: r 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .moon-mask-circle {
    transition:
      cx 0.5s cubic-bezier(0.4, 0, 0.2, 1),
      cy 0.5s cubic-bezier(0.4, 0, 0.2, 1),
      r 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .sun-rays {
    transition:
      opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    transform-origin: center;
  }

  /* Light mode → morphs into crescent moon */
  :global([data-theme="light"]) .theme-toggle-svg {
    transform: rotate(-45deg);
  }
  :global([data-theme="light"]) .sun-core {
    r: 9;
  }
  :global([data-theme="light"]) .moon-mask-circle {
    cx: 18;
    cy: 6;
    r: 8;
  }
  :global([data-theme="light"]) .sun-rays {
    opacity: 0;
    transform: rotate(-90deg);
  }
</style>

<script>
  const toggle = document.getElementById("theme-toggle")!;

  function setTheme(theme: string) {
    document.documentElement.setAttribute("data-theme", theme);
    localStorage.setItem("theme", theme);
  }

  const stored = localStorage.getItem("theme") || "dark";
  setTheme(stored);

  toggle.addEventListener("click", () => {
    const current = document.documentElement.getAttribute("data-theme");
    setTheme(current === "dark" ? "light" : "dark");
  });
</script>
