---
import { Icon } from 'astro-icon/components';

interface Props {
  variant?: 'desktop' | 'mobile';
}

const { variant = 'desktop' } = Astro.props;

// LinkedIn messaging compose URL with pre-filled message
const customMessage = 'Hi Visalan! I came across your portfolio and would love to connect.';
const encodedMessage = encodeURIComponent(customMessage);
const messageLink = `https://www.linkedin.com/messaging/compose/?body=${encodedMessage}&recipient=visalan-h-vizz`;
---

{variant === 'desktop' && (
  <!-- Desktop: Clean text link -->
  <a 
    href={messageLink} 
    target="_blank" 
    rel="noopener noreferrer"
    class="hidden lg:inline-flex items-center gap-2 mt-6 text-slate-400 hover:text-slate-100 transition-colors duration-300 group text-sm"
  >
    <span>Text me on LinkedIn!</span>
    <Icon 
      name="lucide:arrow-up-right" 
      size={14}
      class="transition-transform duration-300 group-hover:translate-x-0.5"
    />
  </a>
)}

{variant === 'mobile' && (
  <!-- Mobile: Expandable floating button -->
  <a 
    href={messageLink} 
    target="_blank" 
    rel="noopener noreferrer"
    id="mobile-linkedin-cta"
    class="lg:hidden fixed bottom-5 right-5 z-50 flex items-center justify-center rounded-full bg-white/5 backdrop-blur-sm border border-white/10 text-slate-400 hover:text-slate-100 hover:bg-white/10 hover:border-white/20 transition-all duration-500 ease-out"
    aria-label="Message me on LinkedIn"
  >
    <Icon name="simple-icons:linkedin" size={18} class="linkedin-icon" />
    <span class="cta-text">Let's connect on LinkedIn!</span>
  </a>

  <script>
    const cta = document.getElementById('mobile-linkedin-cta');
    
    if (cta) {
      let isExpanded = false;
      
      const checkScroll = () => {
        // Don't do anything on desktop
        if (window.matchMedia('(min-width: 1024px)').matches) {
           if (isExpanded) {
             isExpanded = false;
             cta.classList.remove('expanded');
           }
           return;
        }

        // Check if near bottom (within 100px of the end)
        const scrolledToBottom = (window.innerHeight + window.scrollY) >= (document.body.scrollHeight - 100);
        
        if (scrolledToBottom && !isExpanded) {
          isExpanded = true;
          cta.classList.add('expanded');
        } else if (!scrolledToBottom && isExpanded) {
          isExpanded = false;
          cta.classList.remove('expanded');
        }
      };
      
      // Throttle scroll events
      let ticking = false;
      window.addEventListener('scroll', () => {
        if (!ticking) {
          window.requestAnimationFrame(() => {
            checkScroll();
            ticking = false;
          });
          ticking = true;
        }
      });
      
      // Handle resize to reset if moving to desktop
      window.addEventListener('resize', checkScroll);
      
      // Initial check
      checkScroll();
    }
  </script>

  <style>
    @media (max-width: 1023px) {
      #mobile-linkedin-cta {
        width: 52px;
        height: 52px;
        overflow: hidden;
        /* Keep anchored to right */
        right: 20px;
      }

      #mobile-linkedin-cta .cta-text {
        max-width: 0;
        opacity: 0;
        white-space: nowrap;
        font-size: 0.875rem;
        font-weight: 500;
        transition: all 0.4s ease-out;
        margin-left: 0;
      }

      #mobile-linkedin-cta .linkedin-icon {
        flex-shrink: 0;
      }

      /* Expanded state - grows from right to left */
      #mobile-linkedin-cta.expanded {
        width: calc(100vw - 40px);
        height: 52px;
        border-radius: 26px;
        gap: 10px;
        padding: 0 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5em;
      }

      #mobile-linkedin-cta.expanded .cta-text {
        max-width: 250px;
        opacity: 1;
        margin-left: 8px;
      }
    }
  </style>
)}
