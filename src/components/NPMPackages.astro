---
import { Icon } from "astro-icon/components";
import { npmPackages, sectionDescriptions } from "../data/portfolio.json";
const { items: packages, profileLink } = npmPackages;
---

<section
  id="npm-packages"
  class="mb-16 scroll-mt-16 md:mb-24 lg:mb-16 lg:scroll-mt-24"
  aria-label="NPM Packages"
>
  <div
    class="sticky top-0 z-20 -mx-6 mb-6 w-screen bg-background/90 px-6 py-5 pb-4 backdrop-blur md:-mx-12 md:px-12 lg:sr-only lg:relative lg:top-auto lg:mx-auto lg:w-full lg:px-0 lg:py-0 lg:opacity-0 lg:mb-4"
  >
    <h2
      class="text-sm font-bold uppercase tracking-widest text-slate-200 lg:sr-only"
    >
      NPM Packages
    </h2>
    <p class="mt-2 text-sm text-slate-400 lg:hidden">
      {sectionDescriptions["npm-packages"]}
    </p>
  </div>
  <div>
    <ul class="group/list">
      {
        packages.map((pkg) => (
          <li class="mb-12">
            <div class="group relative grid grid-cols-1 gap-4 pb-1 transition-all sm:grid-cols-8 sm:gap-8 md:gap-4 lg:hover:opacity-100! lg:group-hover/list:opacity-50">
              <div class="absolute -inset-x-4 -inset-y-4 z-0 hidden rounded-md transition motion-reduce:transition-none lg:-inset-x-6 lg:block lg:group-hover:bg-slate-800/50 lg:group-hover:shadow-[inset_0_1px_0_0_rgba(148,163,184,0.1)] lg:group-hover:drop-shadow-lg" />
              <div class="z-10 sm:col-span-8">
                <h3 class="font-medium leading-snug text-slate-200">
                  <a
                    class="inline-flex items-baseline font-medium leading-tight text-slate-200 hover:text-slate-100 focus-visible:text-slate-100 group/link"
                    href={pkg.link}
                    target="_blank"
                    rel="noreferrer"
                    aria-label={pkg.name}
                  >
                    <span class="absolute -inset-x-4 -inset-y-2.5 hidden rounded md:-inset-x-6 md:-inset-y-4 lg:block" />
                    <span>
                      {pkg.name}{" "}
                      <span class="inline-block">
                        <Icon
                          name="lucide:arrow-up-right"
                          class="inline-block h-4 w-4 shrink-0 transition-transform duration-300 group-hover/link:-translate-y-1 group-hover/link:translate-x-1 group-focus-visible/link:-translate-y-1 group-focus-visible/link:translate-x-1 motion-reduce:transition-none"
                          aria-hidden="true"
                        />
                      </span>
                    </span>
                  </a>
                </h3>
                <p class="mt-2 text-sm leading-normal text-slate-400">
                  {pkg.description}
                </p>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
    <div class="mt-8">
      <a
        href={profileLink.href}
        class="inline-flex items-center leading-tight font-semibold text-slate-200 group"
        aria-label="View all packages"
      >
        <span
          class="border-b border-transparent pb-px transition group-hover:border-teal-300 motion-reduce:transition-none"
          >{profileLink.text}</span
        >
        <Icon
          name="simple-icons:npm"
          class="ml-1 inline-block h-4 w-4 shrink-0 transition-transform group-hover:translate-x-2 group-focus-visible:translate-x-2 motion-reduce:transition-none"
          aria-hidden="true"
        />
        <Icon
          name="lucide:arrow-right"
          class="ml-1 inline-block h-4 w-4 shrink-0 transition-transform group-hover:translate-x-2 group-focus-visible:translate-x-2 motion-reduce:transition-none"
          aria-hidden="true"
        />
      </a>
    </div>
  </div>
</section>
