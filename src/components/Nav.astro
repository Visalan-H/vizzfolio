---
import data from '../data/portfolio.json';

const navItems = data.nav;
---

<nav class="hidden lg:block">
  <ul class="mt-8 w-max">
    {navItems.map((item) => (
      <li>
        <a
          class="group flex items-center py-3 nav-link"
          href={item.href}
        >
          <span class="mr-4 h-px w-8 bg-slate-600 transition-all duration-300 group-hover:w-16 group-hover:bg-slate-200 group-focus-visible:w-16 group-focus-visible:bg-slate-200 group-[.active]:w-16 group-[.active]:bg-slate-200 motion-reduce:transition-none"></span>
          <span class="text-xs font-bold uppercase tracking-widest text-slate-500 group-hover:text-slate-200 group-focus-visible:text-slate-200 group-[.active]:text-slate-200">
            {item.name}
          </span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const sections = document.querySelectorAll('section');
    const navLinks = document.querySelectorAll('.nav-link');
    
    const visibilityMap = new Map();

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        visibilityMap.set(entry.target.id, entry.intersectionRatio);
      });
      
      updateActiveLink();
    }, {
        threshold: [0, 0.25, 0.5, 0.75, 1],
        rootMargin: '-10% 0px -45% 0px' 
    });

    sections.forEach((section) => {
      observer.observe(section);
      visibilityMap.set(section.id, 0);
    });

    function updateActiveLink() {
        if (window.scrollY < 100) {
            setActive('projects');
            return;
        }

        let maxID = '';
        let maxRatio = 0;

        for (const [id, ratio] of visibilityMap) {
            if (ratio >= maxRatio) {
                maxRatio = ratio;
                maxID = id;
            }
        }

        if (maxID) {
            setActive(maxID);
        }
    }

    function setActive(id) {
        navLinks.forEach((link) => {
            link.classList.remove('active');
            if (link.getAttribute('href') === `#${id}`) {
                link.classList.add('active');
            }
        });
        
        window.dispatchEvent(new CustomEvent('section-change', { detail: id }));
    }

    window.addEventListener('scroll', () => {
        const scrollY = window.scrollY;
        const innerHeight = window.innerHeight;
        const bodyHeight = document.body.offsetHeight;

        if (scrollY < 100) {
            updateActiveLink();
            return;
        }

        if ((innerHeight + scrollY) >= bodyHeight - 50) {
             const lastLink = navLinks[navLinks.length - 1];
             if (lastLink) {
                 const id = lastLink.getAttribute('href')?.substring(1);
                 if (id) setActive(id);
             }
             return;
        }
        
        updateActiveLink();
    }, { passive: true });
    
    updateActiveLink();
  });
</script>
