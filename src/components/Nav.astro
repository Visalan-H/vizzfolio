---
import { nav } from "../data/portfolio.json";
---

<nav class="hidden lg:block">
  <ul class="mt-8 w-max">
    {
      nav.map((item, index) => (
        <li>
          <a class="group flex items-center py-3 nav-link" href={item.href}>
            <span class="mr-4 h-px w-8 bg-slate-600 transition-all duration-300 group-hover:w-16 group-hover:bg-slate-200 group-[.active]:w-16 group-[.active]:bg-slate-200 motion-reduce:transition-none" />
            <span class="text-xs font-bold uppercase tracking-widest text-slate-400 group-hover:text-slate-200 group-[.active]:text-slate-200">
              {item.name}
            </span>
            <kbd class="ml-3 pointer-events-none inline-flex h-5 w-5 select-none items-center justify-center rounded-[4px] border border-slate-800 bg-transparent font-mono text-xs font-medium leading-none text-slate-500 transition-all group-hover:border-slate-400 group-hover:text-slate-200 group-[.active]:border-slate-400 group-[.active]:text-slate-200">
              {index + 1}
            </kbd>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  const sections = document.querySelectorAll("section");
  const navLinks = document.querySelectorAll(".nav-link");
  const navRoot = document.querySelector("nav");
  const visibilityMap = new Map<string, number>();
  let activeId = "projects";

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) =>
        visibilityMap.set(e.target.id, e.intersectionRatio),
      );

      // Bottom of page check
      if (innerHeight + scrollY >= document.body.offsetHeight - 50) {
        setActive("education");
        return;
      }

      // Find most visible section
      let maxId = "projects",
        maxRatio = 0;
      visibilityMap.forEach((ratio, id) => {
        if (ratio >= maxRatio) {
          maxRatio = ratio;
          maxId = id;
        }
      });

      if (maxId !== activeId) setActive(maxId);
    },
    {
      threshold: [0, 0.25, 0.5, 0.75, 1],
      rootMargin: "-10% 0px -45% 0px",
    },
  );

  sections.forEach((s) => {
    observer.observe(s);
    visibilityMap.set(s.id, 0);
  });

  window.addEventListener("load", () => {
    // Only scroll to projects on desktop devices
    if (!window.matchMedia("(min-width: 1024px)").matches) return;

    const projectsSection = document.getElementById("projects");
    if (projectsSection) {
      projectsSection.scrollIntoView({ behavior: "instant" });
      setActive("projects");
    }
  });

  function setActive(id: string) {
    activeId = id;
    navLinks.forEach((link) => {
      link.classList.toggle("active", link.getAttribute("href") === `#${id}`);
    });
    dispatchEvent(new CustomEvent("section-change", { detail: id }));
  }

  // Efficient keyboard navigation by querying the DOM directly
  document.addEventListener("keydown", (e) => {
    // Ignore if user is typing in an input or textarea
    if (
      document.activeElement?.tagName === "INPUT" ||
      document.activeElement?.tagName === "TEXTAREA"
    ) {
      return;
    }

    const key = parseInt(e.key);
    if (isNaN(key) || key === 0) return;

    const index = key - 1;
    // Query the links directly from the DOM to avoid JSON parsing overhead
    // The order in the DOM naturally matches the visual order (1, 2, 3...)
    const currentNavLinks = document.querySelectorAll(".nav-link");

    if (index >= 0 && index < currentNavLinks.length) {
      const link = currentNavLinks[index];
      const targetId = link.getAttribute("href")?.substring(1);

      if (targetId) {
        const targetSection = document.getElementById(targetId);
        if (targetSection) {
          e.preventDefault();
          targetSection.scrollIntoView({ behavior: "smooth" });
        }
      }
    }
  });
</script>
