---
import {nav} from "../data/portfolio.json";
---

<nav class="hidden lg:block">
  <ul class="mt-8 w-max">
    {
      nav.map((item) => (
        <li>
          <a class="group flex items-center py-3 nav-link" href={item.href}>
            <span class="mr-4 h-px w-8 bg-slate-600 transition-all duration-300 group-hover:w-16 group-hover:bg-slate-200 group-[.active]:w-16 group-[.active]:bg-slate-200 motion-reduce:transition-none" />
            <span class="text-xs font-bold uppercase tracking-widest text-slate-500 group-hover:text-slate-200 group-[.active]:text-slate-200">
              {item.name}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  const sections = document.querySelectorAll("section");
  const navLinks = document.querySelectorAll(".nav-link");
  const visibilityMap = new Map<string, number>();
  let activeId = "projects";

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) =>
        visibilityMap.set(e.target.id, e.intersectionRatio),
      );

      // Bottom of page check
      if (innerHeight + scrollY >= document.body.offsetHeight - 50) {
        setActive("education");
        return;
      }

      // Find most visible section
      let maxId = "projects",
        maxRatio = 0;
      visibilityMap.forEach((ratio, id) => {
        if (ratio >= maxRatio) {
          maxRatio = ratio;
          maxId = id;
        }
      });

      if (maxId !== activeId) setActive(maxId);
    },
    {
      threshold: [0, 0.25, 0.5, 0.75, 1],
      rootMargin: "-10% 0px -45% 0px",
    },
  );

  sections.forEach((s) => {
    observer.observe(s);
    visibilityMap.set(s.id, 0);
  });

  function setActive(id: string) {
    activeId = id;
    navLinks.forEach((link) => {
      link.classList.toggle("active", link.getAttribute("href") === `#${id}`);
    });
    dispatchEvent(new CustomEvent("section-change", { detail: id }));
  }
</script>
