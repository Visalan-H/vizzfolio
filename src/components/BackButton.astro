---
import { Icon } from "astro-icon/components";

interface Props {
  mobileText?: string;
  desktopText?: string;
}

const { mobileText = "Back", desktopText = "Back to Portfolio" } = Astro.props;
---

<a
  href="/"
  class="group inline-flex items-center gap-2 rounded-full bg-slate-800/50 px-4 py-2 text-sm font-medium text-teal-300 transition hover:bg-slate-700/60 hover:text-teal-200 focus:outline-none focus:ring-2 focus:ring-teal-300/50"
>
  <Icon
    name="lucide:arrow-left"
    class="h-4 w-4 transition-transform group-hover:-translate-x-1"
  />
  <span class="sm:hidden">{mobileText}</span>
  <span class="hidden sm:inline">{desktopText}</span>
</a>
